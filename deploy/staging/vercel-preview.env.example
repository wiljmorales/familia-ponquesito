# Vercel → Settings → Environment Variables: entorno «Preview» SOLO para la
# rama feature/supabase-to-django-local (Preview → «Select a custom branch»).
# NO contiene secretos: los «<…>» se pegan desde el almacenamiento privado,
# marcados como Sensitive. Ver deploy/staging/README-https.md, sección Vercel.
#
# Antes del primer push de la rama: revisar también las variables de Preview
# para TODAS las ramas. Una variable general de Preview que aquí no se
# sobrescribe llega igual a esta rama. En particular, GEMINI_API_KEY, SMTP_*
# reales, PONQUESITO_* de producción y SUPABASE_* no deben estar en Preview.

# Origen canónico: el alias estable de la rama, que Vercel muestra tras el
# primer despliegue («Domains» del despliegue). Tiene la forma
# familia-ponquesito-git-<rama>-wiljmorales-projects.vercel.app, recortada con
# un hash porque supera 63 caracteres. Hasta conocerlo, un origen inerte:
APP_CANONICAL_URL=https://preview-pendiente.example.invalid

NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/584248532526

# API de staging en el VPS (no la de producción).
PONQUESITO_API_URL=https://api-staging.familiaponquesito.com
# Sensitive. Copia privada: respaldos-privado/staging-vps/secretos/internal-api-key
PONQUESITO_INTERNAL_API_KEY=<clave interna de staging>

# SMTP de pruebas (Mailpit en el VPS): TLS implícito en 465, AUTH, solo
# @example.invalid, sin reenvío. Nada sale a destinatarios reales.
SMTP_HOST=api-staging.familiaponquesito.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vercel-preview
# Sensitive. Copia privada de ~/fp-staging-https/entrega/smtp-password
SMTP_APP_PASSWORD=<contraseña SMTP de pruebas>
EMAIL_FROM=Familia Ponquesito Preview <preview@example.invalid>
KAREM_NOTIFICATION_EMAIL=propietaria.preview@example.invalid
AGENT_DEMO_CUSTOMER_EMAIL=cliente.preview@example.invalid

# Sensitive. Nuevo y solo para Preview (openssl rand -hex 32); los cron de
# vercel.json no se ejecutan en Preview: sirve para probar el endpoint a mano.
CRON_SECRET=<secreto nuevo de Preview>

# Sin definir en Preview: GEMINI_API_KEY (sin clave se usa el comportamiento
# determinista, sin llamadas a Gemini), GEMINI_MODEL y PONQUESITO_STANDALONE.
