# HISTÓRICO (2026-10-18): NO instalar. El destino vigente es Next.js en Vercel
# y solo la API Django en este VPS: usar Caddyfile.api. Ver docs/decisions.md.
# /etc/caddy/Caddyfile — PRODUCCIÓN (preparado, NO instalado). Se usará solo
# cuando el dominio principal apunte a este VPS. Incluye también staging.
{
	servers {
		protocols h1 h2
	}
}

import /etc/caddy/ponquesito.caddy

familiaponquesito.com {
	log
	import ponquesito_cabeceras
	route {
		import ponquesito_rutas 127.0.0.1:8000 127.0.0.1:3000
	}
}

# www → apex conservando ruta y parámetros.
www.familiaponquesito.com {
	redir https://familiaponquesito.com{uri} 301
}

staging.familiaponquesito.com {
	log
	import ponquesito_cabeceras
	header X-Robots-Tag "noindex, nofollow, noarchive"
	route {
		basic_auth {
			{$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
		}
		import ponquesito_staging_guard
		import ponquesito_rutas 127.0.0.1:8000 127.0.0.1:3000
	}
	handle_errors 502 {
		respond "Servicio todavía no disponible en staging" 503
	}
}
