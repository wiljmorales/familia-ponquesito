# Familia Ponquesito — rutas compartidas por staging, producción y la prueba
# local. Se importa dentro de un bloque `route` para que el orden sea literal.
#
#   import ponquesito_rutas <upstream-django> <upstream-next>
#
# Contrato (ver deploy/caddy/README.md): Django solo atiende /health/ y
# /api/v1/*; todo lo demás, incluidos /, /linktree y el resto de /api/*, es
# de Next.js. Caddy no sirve páginas propias.

(ponquesito_rutas) {
	# Django recibe la ruta completa, sin recortes. /api/v1x o /api/v10 no
	# coinciden: siguen a Next.js.
	@django path /health /health/ /api/v1 /api/v1/*
	handle @django {
		reverse_proxy {args[0]} {
			import ponquesito_ip_cliente
		}
	}

	# Todo lo demás: Next.js.
	handle {
		reverse_proxy {args[1]} {
			import ponquesito_ip_cliente
		}
	}
}

# Lanzamiento fase 1 (2026-10-09): solo la página de enlaces es pública.
#
#   import ponquesito_fase1 <upstream-django> <upstream-next>
#
# Lista blanca: /linktree (y /linktree/, que Next.js redirige con 308), sus
# recursos (/favicon.svg y /assets/logo-familia-ponquesito.png, nada más de /assets/) y /health/ de
# Django. / redirige con
# 302 a /linktree conservando los parámetros. Cualquier otra ruta, incluidas
# /api/* (también /api/v1/*), /_next/* y las páginas de la aplicación, es 404
# de Caddy y no llega a ninguna aplicación. En las rutas permitidas solo se
# aceptan GET y HEAD (405 para el resto): la página no tiene formularios.
(ponquesito_fase1) {
	@no_publico not path / /linktree /linktree/ /favicon.svg /assets/logo-familia-ponquesito.png /health/
	respond @no_publico "No encontrado" 404

	@no_lectura not method GET HEAD
	header @no_lectura Allow "GET, HEAD"
	respond @no_lectura "Método no permitido" 405

	@raiz path /
	redir @raiz /linktree{?query} 302

	handle /health/ {
		reverse_proxy {args[0]} {
			import ponquesito_ip_cliente
		}
	}
	handle {
		reverse_proxy {args[1]} {
			import ponquesito_ip_cliente
		}
	}
}

# IP del cliente hacia las aplicaciones. Caddy es el único proxy público: la
# IP es la del par TCP ({remote_host}) y el cliente no puede elegirla. Los
# limitadores de Next.js usan el primer valor de X-Forwarded-For (y X-Real-IP
# si faltara). Sin esto, Caddy ya reemplaza X-Forwarded-For, pero deja pasar
# X-Real-IP y Forwarded tal como los envía el cliente.
#
# Si algún día se pone Cloudflare u otro proxy delante de Caddy, {remote_host}
# sería la IP de ese proxy: habría que configurar trusted_proxies y
# client_ip_headers y revisar esta regla (deploy/caddy/README.md).
(ponquesito_ip_cliente) {
	header_up X-Forwarded-For {remote_host}
	header_up X-Real-IP {remote_host}
	header_up -Forwarded
}

# Staging: nada de Next.js que escriba datos o envíe correos. Bloquea, solo
# hacia Next.js, todo método distinto de GET/HEAD (las Server Actions son
# POST) y sus rutas /api/* (asistente, agente, reporte con cron). Django
# (/health/ y /api/v1/*) no se bloquea: aplica su propio CSRF.
(ponquesito_staging_guard) {
	@escrituras_next {
		not path /health /health/ /api/v1 /api/v1/*
		not method GET HEAD
	}
	respond @escrituras_next "Deshabilitado en staging" 403
	@api_next {
		path /api/*
		not path /api/v1 /api/v1/*
	}
	respond @api_next "Deshabilitado en staging" 403
}

# Cabeceras comunes de seguridad.
(ponquesito_cabeceras) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
