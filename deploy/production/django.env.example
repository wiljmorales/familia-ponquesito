# Fragmento para COMBINAR con backend.env, no reemplazarlo.
# Conservar DJANGO_SECRET_KEY y POSTGRES_* actuales fuera del repositorio.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.familiaponquesito.com,127.0.0.1,localhost
DJANGO_BEHIND_HTTPS_PROXY=true
# El navegador no llama a Django; Next.js servidor usa Bearer.
# Una futura autenticación con cookies requerirá decidir CORS/CSRF primero.
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.familiaponquesito.com
PONQUESITO_INTERNAL_API_KEY=
PONQUESITO_PRIVATE_IMAGE_ROOT=/var/lib/ponquesito/images
PONQUESITO_API_PUBLIC_URL=https://api.familiaponquesito.com
