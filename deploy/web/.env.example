# Variables de Next.js en el VPS. Plantilla sin valores reales: nunca pongas
# aquí un secreto ni un dato del servidor.
#
# Hay dos usos distintos:
#   - BUILD: se leen al compilar en tu PC (BUILD_ENV_FILE=<archivo fuera de
#     Git> deploy/web/build-artifact.sh). Next.js las graba en el bundle; para
#     cambiarlas hay que recompilar. Son públicas por naturaleza.
#   - RUNTIME: van en /etc/ponquesito/web.env del VPS (root, 600), que lee
#     systemd al arrancar. Cambiarlas solo requiere reiniciar el servicio.
#
# Las líneas comentadas quedan sin definir, que es lo correcto para staging:
# la app arranca sin ninguna de ellas. NO definas HOSTNAME, PORT ni NODE_ENV:
# los fija ponquesito-web.service.

# ---------------------------------------------------------------- BUILD ----

# Origen HTTPS canónico (metadata, enlaces de correos). También es RUNTIME:
# las páginas estáticas guardan el valor del build y el servidor usa el de
# runtime, así que ambos deben coincidir. Sin valor: el de producción en
# Vercel (src/lib/site-url.ts).
# APP_CANONICAL_URL=https://staging.example.com

# Enlace de WhatsApp del negocio: lo usa código del navegador, así que solo
# cuenta el valor del build. Sin valor no se muestra el enlace.
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/<número>

# -------------------------------------------------------------- RUNTIME ----

# APP_CANONICAL_URL=https://staging.example.com

# Supabase (formulario de la landing, agenda, reservas). Sin ellas, esas
# acciones fallan; las páginas cargan igual.
# NEXT_PUBLIC_SUPABASE_URL solo se lee en el servidor: va aquí y NO en el
# build (si se compila con ella, Next.js grabaría ese valor en el bundle).
# NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Gemini. Sin clave: /api/assistant falla de forma explícita en producción;
# el agente y el reporte usan su modo determinista.
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Correo (SMTP). Sin ellas, cada envío se registra como error; nunca se simula.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_APP_PASSWORD=
# EMAIL_FROM=
# KAREM_NOTIFICATION_EMAIL=
# AGENT_DEMO_CUSTOMER_EMAIL=

# Protege GET /api/reports/weekly. Sin valor responde 503 y no ejecuta nada.
# El cron vive en Vercel (vercel.json); el VPS no lo programa.
# CRON_SECRET=
