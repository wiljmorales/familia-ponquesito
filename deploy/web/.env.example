# Variables de Next.js en el VPS. Plantilla sin valores reales: nunca pongas
# aquí un secreto ni un dato del servidor.
#
# Hay dos usos distintos:
#   - BUILD: se leen al compilar en tu PC (BUILD_ENV_FILE=<archivo>
#     deploy/web/build-artifact.sh; staging: deploy/web/staging.build.env).
#     Next.js las graba en el bundle; para cambiarlas hay que recompilar. Son
#     públicas por naturaleza y viajan en el artefacto (BUILD_ENV), que se
#     identifica por ellas.
#   - RUNTIME: van en /etc/ponquesito/web.env del VPS (root, 600), que lee
#     systemd al arrancar. Cambiarlas solo requiere reiniciar el servicio.
#
# Las líneas comentadas quedan sin definir. Staging arranca solo con
# APP_CANONICAL_URL. NO definas HOSTNAME, PORT ni NODE_ENV: los fija
# ponquesito-web.service.

# ---------------------------------------------------------------- BUILD ----

# OBLIGATORIA. Origen HTTPS canónico exacto (metadata, enlaces de correos),
# sin ruta ni barra final. También es RUNTIME: las páginas estáticas guardan
# el valor del build y el servidor usa el de runtime, así que deben ser
# idénticos; ponquesito-web-release se niega a activar si no lo son. Sin
# ella, Next.js usaría la URL de producción en Vercel, y por eso el build
# standalone falla.
# APP_CANONICAL_URL=https://staging.example.com

# WhatsApp oficial del negocio: lo usa código del navegador, así que solo
# cuenta el valor del build (staging lo fija en staging.build.env). Sin
# valor no se muestran el enlace del footer ni "Continuar por WhatsApp".
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/584248532526

# -------------------------------------------------------------- RUNTIME ----

# OBLIGATORIA y exactamente la del build (BUILD_INFO del artefacto).
# APP_CANONICAL_URL=https://staging.example.com

# API Django para los flujos de negocio (solo servidor). La credencial es
# distinta de DJANGO_SECRET_KEY y jamás va en el build ni en NEXT_PUBLIC_*.
# PONQUESITO_API_URL=https://api.familiaponquesito.com
# PONQUESITO_INTERNAL_API_KEY=

# Gemini. Sin clave: /api/assistant falla de forma explícita en producción;
# el agente y el reporte usan su modo determinista.
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Correo (SMTP). Sin ellas, cada envío se registra como error; nunca se simula.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_APP_PASSWORD=
# EMAIL_FROM=
# KAREM_NOTIFICATION_EMAIL=
# AGENT_DEMO_CUSTOMER_EMAIL=

# Protege GET /api/reports/weekly. Sin valor responde 503 y no ejecuta nada.
# El cron vive en Vercel (vercel.json); el VPS no lo programa.
# CRON_SECRET=
