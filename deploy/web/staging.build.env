# Variables de build de staging (públicas: quedan en el bundle). Uso:
#   BUILD_ENV_FILE=deploy/web/staging.build.env deploy/web/build-artifact.sh
# /etc/ponquesito/web.env del VPS debe tener el mismo APP_CANONICAL_URL;
# ponquesito-web-release se niega a activar si no coincide.
APP_CANONICAL_URL=https://staging.familiaponquesito.com
# WhatsApp oficial del negocio (confirmado en octubre de 2026): el mismo
# número que el botón "Pedir por WhatsApp" de public/linktree.html. Sin
# mensaje: la app añade el suyo (buildWhatsappMessageUrl).
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/584248532526
