# Copia este archivo fuera del repositorio (en el VPS:
# /srv/ponquesito/backend.env, <admin>:ponquesito 640) y rellena los valores.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=ponquesito
POSTGRES_USER=ponquesito_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PONQUESITO_INTERNAL_API_KEY=
PONQUESITO_PRIVATE_IMAGE_ROOT=/var/lib/ponquesito/images
PONQUESITO_API_PUBLIC_URL=https://api.familiaponquesito.com
# Solo al publicar detrás de Caddy (staging/producción):
# DJANGO_BEHIND_HTTPS_PROXY=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.familiaponquesito.com
# (y añadir el nombre público a DJANGO_ALLOWED_HOSTS)
