# Clave de Google AI Studio (https://aistudio.google.com/apikey).
# Copia este archivo como .env.local y pon tu clave. Sin clave, la app
# funciona con el proveedor determinista de demostración.
GEMINI_API_KEY=

# Opcional: modelo a usar (por defecto gemini-3.1-flash-lite).
GEMINI_MODEL=gemini-3.1-flash-lite

# --- API privada de negocio: Next.js servidor → Django ---
# Nunca usar prefijo NEXT_PUBLIC_. El mismo valor de la credencial debe
# configurarse en Django, distinto de DJANGO_SECRET_KEY y de PostgreSQL.
PONQUESITO_API_URL=https://api.familiaponquesito.com
PONQUESITO_INTERNAL_API_KEY=

# Origen HTTPS canónico usado para metadata y enlaces privados de correos.
# En producción puede omitirse (usa https://familia-ponquesito.vercel.app).
# Para probar correos en Preview, configúralo explícitamente con el alias
# estable de esa rama, sin ruta final ni slash adicional. Nunca uses Host,
# Origin o VERCEL_URL para construir enlaces privados.
APP_CANONICAL_URL=

# WhatsApp oficial del negocio (+58 424-8532526, confirmado en octubre de
# 2026; ver docs/decisions.md). Pública: se graba en el bundle al compilar.
# Va sin mensaje: la app añade el suyo. Activa el enlace del footer y el
# botón "Continuar por WhatsApp" de /crea-tu-torta; sin ella no se muestran.
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/584248532526

# --- Reto 4: automatización de leads (correo por SMTP de Gmail) ---
# Sin las variables de esta sección, en desarrollo/test el envío de
# correos usa un stub que solo registra en consola (no envía nada real, no
# rompe `npm run dev` ni `npm test`). En producción, si falta cualquiera,
# el paso de correo correspondiente se registra como error en
# lead_automation_events — nunca se simula un envío exitoso.
#
# Valores para la cuenta Gmail exclusiva del negocio:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=<la cuenta Gmail del negocio>
#   EMAIL_FROM=Familia Ponquesito <la misma cuenta Gmail>
# EMAIL_FROM debe corresponder a la misma cuenta autenticada en SMTP_USER
# (Gmail reescribe remitentes ajenos). Todas se leen solo en el servidor.
SMTP_HOST=
SMTP_PORT=

# Opcional: "true" para TLS implícito (SMTPS). Si se omite, se infiere del
# puerto: true solo para 465; otros puertos (587) negocian STARTTLS.
SMTP_SECURE=

SMTP_USER=

# Contraseña de APLICACIÓN de Gmail (https://myaccount.google.com/apppasswords,
# requiere verificación en dos pasos). NUNCA la contraseña normal de la
# cuenta, y NUNCA en un archivo versionado — solo .env.local y Vercel.
SMTP_APP_PASSWORD=

EMAIL_FROM=

# Correo donde Karem recibe la notificación inmediata de cada lead nuevo.
# No hay un correo de negocio confirmado en la base de conocimiento
# todavía (ver src/knowledge/familia-ponquesito.md); mientras tanto, usa
# aquí un correo de pruebas. Nunca subas este valor a un archivo versionado.
# El reporte semanal del Reto 6 usa este mismo destinatario.
KAREM_NOTIFICATION_EMAIL=

# Solo para el caso demostrativo del agente: casilla controlada por el negocio.
# Si falta, usa KAREM_NOTIFICATION_EMAIL; nunca un destinatario inventado.
AGENT_DEMO_CUSTOMER_EMAIL=

# --- Reto 6: reporte semanal "Pulso Ponquesito" (Vercel Cron) ---
# Secreto que protege GET /api/reports/weekly. Vercel Cron lo envía
# automáticamente como "Authorization: Bearer <CRON_SECRET>" cuando la
# variable está configurada en el proyecto; una verificación manual usa el
# mismo header (nunca por query param). Sin esta variable, el endpoint
# responde 503 y no ejecuta nada — jamás corre un cron desprotegido.
# Genera un valor largo y aleatorio (ej. `openssl rand -hex 32`) y
# configúralo solo en .env.local y en Vercel, nunca en un archivo
# versionado.
CRON_SECRET=
